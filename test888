-- Add the function to update the tracer line
local function updateTracerLine(target)
    if not DrawTracerLine or not target or not target.Character or not target.Character:FindFirstChild("Head") then
        TracerLine.Visible = false
        return
    end
    
    local localPlayer = game.Players.LocalPlayer
    if not localPlayer or not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        TracerLine.Visible = false
        return
    end
    
    local camera = game.Workspace.CurrentCamera
    local localPlayerPos = localPlayer.Character.HumanoidRootPart.Position
    local targetHeadPos = target.Character.Head.Position
    
    local localPlayerScreenPos = camera:WorldToScreenPoint(localPlayerPos)
    local targetHeadScreenPos = camera:WorldToScreenPoint(targetHeadPos)
    
    if localPlayerScreenPos.Z > 0 and targetHeadScreenPos.Z > 0 then
        TracerLine.From = Vector2.new(localPlayerScreenPos.X, localPlayerScreenPos.Y)
        TracerLine.To = Vector2.new(targetHeadScreenPos.X, targetHeadScreenPos.Y)
        TracerLine.Visible = true
    else
        TracerLine.Visible = false
    end
end

-- Add hook to override damage calculation
local function setupDamageOverride()
    if not ForceHeadshotDamage then return end
    
    -- แก้ไขวิธีการโอเวอร์ไรด์ให้ทำงานได้กับ Roblox ทั่วไป
    -- เพิ่มการติดตามอีเวนต์ที่เกี่ยวข้องกับดาเมจแทนการใช้ meta table
    
    -- ตรวจจับอีเวนต์ยิงหรือโดนดาเมจที่มักมีอยู่ในเกม
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") and (v.Name:match("Damage") or v.Name:match("Hit") or v.Name:match("Shot")) then
            -- สร้าง connection เพื่อดักจับการยิงและแก้ไขข้อมูล
            v.OnClientEvent:Connect(function(...)
                local args = {...}
                -- แก้ไขข้อมูลถ้าจำเป็น (นี่เป็นแค่ตัวอย่าง)
                -- ต้องปรับให้เข้ากับระบบของเกมที่ใช้งานจริง
            end)
        end
    end
    
    -- การแจ้งเตือน
    Rayfield:Notify({
        Title = "Aimbot God",
        Content = "ระบบบังคับยิงหัวเปิดใช้งานแล้ว (อาจจำเป็นต้องปรับให้เข้ากับเกมที่คุณเล่น)",
        Duration = 5,
    })
end

